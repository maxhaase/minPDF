# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    cat <<'USAGE'
Usage: minpdf [OPTIONS] FILE...

Multi-use utility for PDF files.
Currently supports size minimization and merging; more utilities
are planned.

Options:
  -g             Produce a grayscale output PDF (default: color).
  -q PERCENT     Quality to preserve, 0-100 (default: 75).
                 Higher = better quality, larger file.
                 Lower  = smaller file, more aggressive compression.
  -o NAME        Write the output to NAME.
                 By default the output is written next to the first
                 input file as <basename>_YYYYMMDD_hhmmss.pdf
                 (so the source is never overwritten).
  -h             Show this help and exit.

Arguments:
  FILE...        One or more input PDF files.
                 Use '*' to process every PDF in the current directory:
                     minpdf -q 60 -g *

Behavior with multiple files:
  When more than one input is given, they are first merged with
  pdfunite and then compressed as a single document.

Requires:
  ghostscript (gs), poppler-utils / poppler (pdfunite).
  Missing programs are reported in red and can be installed
  automatically (sudo password will be requested).

Examples:
  minpdf -q 80 report.pdf
      -> report_20261020_192044.pdf

  minpdf -q 50 -g *.pdf
      -> first_20261020_192100.pdf  (all input merged)

  minpdf -q 90 -o final.pdf a.pdf b.pdf
      -> final.pdf                  (a.pdf and b.pdf merged + compressed)
USAGE
}

# ---------------------------------------------------------------------------
# Dependency handling
# ---------------------------------------------------------------------------
DEPS=(
  "gs:ghostscript:ghostscript:ghostscript"
  "pdfunite:poppler-utils:poppler-utils:poppler"
)

MISSING=()

find_missing_deps() {
    MISSING=()
    for dep in "${DEPS[@]}"; do
        IFS=: read -r bin _ _ _ <<<"$dep"
        command -v "$bin" >/dev/null 2>&1 || MISSING+=("$dep")
    done
}

detect_pkg_manager() {
    if   command -v apt-get >/dev/null 2>&1; then echo apt
    elif command -v dnf     >/dev/null 2>&1; then echo dnf
    elif command -v yum     >/dev/null 2>&1; then echo yum
    elif command -v zypper  >/dev/null 2>&1; then echo zypper
    elif command -v pacman  >/dev/null 2>&1; then echo pacman
    else echo none
    fi
}

install_deps() {
    local pm deb_pkgs=() rpm_pkgs=() arch_pkgs=()
    pm=$(detect_pkg_manager)

    for dep in "${MISSING[@]}"; do
        IFS=: read -r _ deb rpm arch <<<"$dep"
        deb_pkgs+=("$deb")
        rpm_pkgs+=("$rpm")
        arch_pkgs+=("$arch")
    done

    case "$pm" in
        apt)    sudo apt-get update && sudo apt-get install -y "${deb_pkgs[@]}" ;;
        dnf)    sudo dnf    install -y "${rpm_pkgs[@]}" ;;
        yum)    sudo yum    install -y "${rpm_pkgs[@]}" ;;
        zypper) sudo zypper install -y "${rpm_pkgs[@]}" ;;
        pacman) sudo pacman -Sy --noconfirm "${arch_pkgs[@]}" ;;
        *)
            printf '\033[1;31mNo supported package manager found.\033[0m\n' >&2
            printf 'Install manually: %s\n' "${deb_pkgs[*]}" >&2
            return 1
            ;;
    esac
}

check_deps() {
    find_missing_deps
    [ ${#MISSING[@]} -eq 0 ] && return 0

    echo
    printf '\033[1;31mThe following required programs are missing:\033[0m\n'
    for dep in "${MISSING[@]}"; do
        IFS=: read -r bin deb rpm arch <<<"$dep"
        printf '  \033[1;31m%-10s\033[0m  (apt: %s | rpm: %s | arch: %s)\n' \
            "$bin" "$deb" "$rpm" "$arch"
    done
    echo
    read -r -p "Install them now with sudo? [y/N] " ans
    case "$ans" in
        [Yy]|[Yy][Ee][Ss])
            if install_deps; then
                find_missing_deps
                if [ ${#MISSING[@]} -gt 0 ]; then
                    printf '\033[1;31mStill missing after install; aborting.\033[0m\n' >&2
                    exit 1
                fi
            else
                printf '\033[1;31mInstallation failed; aborting.\033[0m\n' >&2
                exit 1
            fi
            ;;
        *)
            printf '\033[1;31mCannot continue without the required programs.\033[0m\n' >&2
            exit 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
minify_one() {
    local input="$1" output="$2"
    local color_res gray_res mono_res jpeg_q

    color_res=$(( 72 + (QUALITY * (300 - 72)) / 100 ))
    gray_res=$color_res
    mono_res=$(( 300 + (QUALITY * (1200 - 300)) / 100 ))
    jpeg_q=$(( 10 + (QUALITY * 90) / 100 ))

    local args=(
        -sDEVICE=pdfwrite
        -dCompatibilityLevel=1.5
        -dNOPAUSE -dBATCH
        -dDetectDuplicateImages=true
        -dCompressFonts=true
        -dSubsetFonts=true
        -dEmbedAllFonts=true
        -dAutoRotatePages=/None
        -dDownsampleColorImages=true
        -dColorImageDownsampleType=/Bicubic
        -dColorImageResolution="$color_res"
        -dColorImageDownsampleThreshold=1.1
        -dDownsampleGrayImages=true
        -dGrayImageDownsampleType=/Bicubic
        -dGrayImageResolution="$gray_res"
        -dGrayImageDownsampleThreshold=1.1
        -dDownsampleMonoImages=true
        -dMonoImageDownsampleType=/Subsample
        -dMonoImageResolution="$mono_res"
        -dMonoImageDownsampleThreshold=1.1
        -dJPEGQ="$jpeg_q"
        -sOutputFile="$output"
    )

    if [ "$GRAYSCALE" = "1" ]; then
        args+=(-sColorConversionStrategy=Gray -dProcessColorModel=/DeviceGray)
    else
        args+=(-sColorConversionStrategy=LeaveColorUnchanged)
    fi

    gs "${args[@]}" "$input"
}

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
report_sizes() {
    local out="$1"
    local out_sz in_sz=0 s
    out_sz=$(stat -c%s "$out" 2>/dev/null || stat -f%z "$out")

    for f in "${FILES[@]}"; do
        s=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f") || continue
        in_sz=$(( in_sz + s ))
    done

    printf 'Input  : %s bytes (%d file%s)\n' "$in_sz" "${#FILES[@]}" \
        "$([ "${#FILES[@]}" -ne 1 ] && echo s)"
    printf 'Output : %s bytes  ->  %s\n' "$out_sz" "$out"
    if [ "$in_sz" -gt 0 ]; then
        awk -v a="$in_sz" -v b="$out_sz" \
            'BEGIN { printf "Reduction: %.1f%%\n", (a-b)*100/a }'
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    show_banner
    echo
    echo "*** minPDF by Max Haase ***"
    echo

    GRAYSCALE=0
    QUALITY=75
    OUTPUT_NAME=""

        # Use GNU getopt so options may appear before, between, or after files.
    if ! PARSED=$(getopt -o gq:o:h -l grayscale,quality:,output:,help \
                      -n 'minpdf' -- "$@"); then
        echo >&2
        usage
        exit 1
    fi
    eval set -- "$PARSED"

    while true; do
        case "$1" in
            -g|--grayscale) GRAYSCALE=1; shift ;;
            -q|--quality)
                QUALITY="$2"
                if ! [[ "$QUALITY" =~ ^[0-9]+$ ]] || (( QUALITY < 0 || QUALITY > 100 )); then
                    printf '\033[1;31m-q expects an integer between 0 and 100.\033[0m\n' >&2
                    echo
                    usage
                    exit 1
                fi
                shift 2
                ;;
            -o|--output) OUTPUT_NAME="$2"; shift 2 ;;
            -h|--help)   usage; exit 0 ;;
            --)          shift; break ;;
            *)           break ;;
        esac
    done

    if [ $# -eq 0 ]; then
        usage
        exit 1
    fi

    check_deps

    # Expand literal '*' -> all PDFs in cwd
    FILES=()
    for arg in "$@"; do
        if [ "$arg" = "*" ]; then
            shopt -s nullglob nocaseglob
            for f in *.pdf; do FILES+=("$f"); done
            shopt -u nullglob nocaseglob
        else
            FILES+=("$arg")
        fi
    done

    if [ ${#FILES[@]} -eq 0 ]; then
        printf '\033[1;31mNo PDF files found.\033[0m\n' >&2
        exit 1
    fi

    for f in "${FILES[@]}"; do
        if [ ! -f "$f" ]; then
            printf '\033[1;31mNot a regular file: %s\033[0m\n' "$f" >&2
            exit 1
        fi
    done

    local first_base ts output tmpdir="" merged_input=""
    first_base="$(basename "${FILES[0]}" .pdf)"

    if [ -n "$OUTPUT_NAME" ]; then
        output="$OUTPUT_NAME"
        if [ -e "$output" ]; then
            printf '\033[1;31mRefusing to overwrite existing file: %s\033[0m\n' "$output" >&2
            printf 'Remove it first or pick a different name with -o.\n' >&2
            exit 1
        fi
    else
        ts=$(date +%Y%m%d_%H%M%S)
        output="${first_base}_${ts}.pdf"
        while [ -e "$output" ]; do
            sleep 1
            ts=$(date +%Y%m%d_%H%M%S)
            output="${first_base}_${ts}.pdf"
        done
    fi

    # Never allow output == any input
    for f in "${FILES[@]}"; do
        if [ "$f" = "$output" ]; then
            printf '\033[1;31mOutput file must not be an input file: %s\033[0m\n' "$output" >&2
            exit 1
        fi
    done

    if [ ${#FILES[@]} -eq 1 ]; then
        merged_input="${FILES[0]}"
    else
        tmpdir=$(mktemp -d -t minpdf-XXXXXX)
        trap 'rm -rf "$tmpdir"' EXIT
        merged_input="$tmpdir/merged.pdf"
        echo "Merging ${#FILES[@]} files with pdfunite ..."
        if ! pdfunite "${FILES[@]}" "$merged_input"; then
            printf '\033[1;31mpdfunite failed.\033[0m\n' >&2
            exit 1
        fi
    fi

    echo
    printf 'Compressing  %s\n  ->  %s\n  quality=%s  grayscale=%s\n\n' \
        "$merged_input" "$output" "$QUALITY" "$GRAYSCALE"

    if ! minify_one "$merged_input" "$output"; then
        printf '\033[1;31mGhostscript failed.\033[0m\n' >&2
        exit 1
    fi

    report_sizes "$output"
}

main "$@"
