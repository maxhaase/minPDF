# ---- Usage ---------------------------------------------------------------
usage() {
    cat <<'USAGE'
Usage: minpdf [OPTIONS] FILE...

Multi-use utility for PDF files.

Options:
  -g             Produce a grayscale output PDF (default: color).
  -q PERCENT     Quality to preserve, 0-100 (default: 75).
  -o NAME        Write the output to NAME.
                 Default: <basename>_YYYYMMDD_hhmmss.pdf
  -h             Show this help and exit.

Use '*' to process every PDF in the current directory.
When more than one input is given, files are merged with pdfunite
before compression.

Requires: ghostscript (gs), poppler-utils / poppler (pdfunite).
USAGE
}

# ---- Dependency check ----------------------------------------------------
DEPS=("gs:ghostscript:ghostscript:ghostscript"
      "pdfunite:poppler-utils:poppler-utils:poppler")
MISSING=()

find_missing() {
    MISSING=()
    for dep in "${DEPS[@]}"; do
        IFS=: read -r bin _ _ _ <<<"$dep"
        command -v "$bin" >/dev/null 2>&1 || MISSING+=("$dep")
    done
}

detect_pm() {
    for pm in apt-get dnf yum zypper pacman; do
        command -v "$pm" >/dev/null && { echo "$pm"; return; }
    done
    echo none
}

check_deps() {
    find_missing
    [ ${#MISSING[@]} -eq 0 ] && return 0
    echo
    printf '\033[1;31mMissing programs:\033[0m\n'
    for dep in "${MISSING[@]}"; do
        IFS=: read -r bin deb rpm arch <<<"$dep"
        printf '  \033[1;31m%-10s\033[0m  (apt: %s | rpm: %s | arch: %s)\n' \
            "$bin" "$deb" "$rpm" "$arch"
    done
    read -r -p "Install now with sudo? [y/N] " a
    case "$a" in [Yy]*)
        local deb_pkgs=() rpm_pkgs=() arch_pkgs=()
        for dep in "${MISSING[@]}"; do
            IFS=: read -r _ d r ar <<<"$dep"
            deb_pkgs+=("$d"); rpm_pkgs+=("$r"); arch_pkgs+=("$ar")
        done
        case "$(detect_pm)" in
            apt-get) sudo apt-get update && sudo apt-get install -y "${deb_pkgs[@]}" ;;
            dnf|yum) sudo "$(detect_pm)" install -y "${rpm_pkgs[@]}" ;;
            zypper)  sudo zypper install -y "${rpm_pkgs[@]}" ;;
            pacman)  sudo pacman -Sy --noconfirm "${arch_pkgs[@]}" ;;
            *) echo "No package manager found." >&2; exit 1 ;;
        esac
        find_missing
        [ ${#MISSING[@]} -gt 0 ] && { echo "Still missing; aborting." >&2; exit 1; }
        ;;
    *) exit 1 ;;
    esac
}

# ---- Core compression ----------------------------------------------------
minify_one() {
    local input="$1" output="$2"
    local c_res m_res jq
    c_res=$(( 72 + (QUALITY * 228) / 100 ))
    m_res=$(( 300 + (QUALITY * 900) / 100 ))
    jq=$(( 10 + (QUALITY * 90) / 100 ))
    local args=(
        -sDEVICE=pdfwrite -dCompatibilityLevel=1.5 -dNOPAUSE -dBATCH
        -dDetectDuplicateImages=true -dCompressFonts=true
        -dSubsetFonts=true -dEmbedAllFonts=true -dAutoRotatePages=/None
        -dDownsampleColorImages=true -dColorImageDownsampleType=/Bicubic
        -dColorImageResolution="$c_res" -dColorImageDownsampleThreshold=1.1
        -dDownsampleGrayImages=true -dGrayImageDownsampleType=/Bicubic
        -dGrayImageResolution="$c_res" -dGrayImageDownsampleThreshold=1.1
        -dDownsampleMonoImages=true -dMonoImageDownsampleType=/Subsample
        -dMonoImageResolution="$m_res" -dMonoImageDownsampleThreshold=1.1
        -dJPEGQ="$jq" -sOutputFile="$output"
    )
    if [ "$GRAYSCALE" = 1 ]; then
        args+=(-sColorConversionStrategy=Gray -dProcessColorModel=/DeviceGray)
    else
        args+=(-sColorConversionStrategy=LeaveColorUnchanged)
    fi
    gs "${args[@]}" "$input"
}

# ---- Main ----------------------------------------------------------------
main() {
    [ -t 1 ] && { show_banner; echo; }
    echo "*** minPDF by Max Haase ***"
    echo

    GRAYSCALE=0; QUALITY=75; OUTPUT_NAME=""

    if ! PARSED=$(getopt -o gq:o:h -l grayscale,quality:,output:,help \
                       -n 'minpdf' -- "$@"); then
        usage; exit 1
    fi
    eval set -- "$PARSED"
    while true; do
        case "$1" in
            -g|--grayscale) GRAYSCALE=1; shift ;;
            -q|--quality)
                QUALITY="$2"
                if ! [[ "$QUALITY" =~ ^[0-9]+$ ]] || (( QUALITY < 0 || QUALITY > 100 )); then
                    echo "-q expects 0-100" >&2; exit 1
                fi
                shift 2 ;;
            -o|--output) OUTPUT_NAME="$2"; shift 2 ;;
            -h|--help)   usage; exit 0 ;;
            --)          shift; break ;;
            *)           break ;;
        esac
    done

    [ $# -eq 0 ] && { usage; exit 1; }
    check_deps

    FILES=()
    for a in "$@"; do
        if [ "$a" = "*" ]; then
            shopt -s nullglob nocaseglob
            for f in *.pdf; do FILES+=("$f"); done
            shopt -u nullglob nocaseglob
        else
            FILES+=("$a")
        fi
    done
    [ ${#FILES[@]} -eq 0 ] && { echo "No PDF files found." >&2; exit 1; }
    for f in "${FILES[@]}"; do
        [ -f "$f" ] || { echo "Not a regular file: $f" >&2; exit 1; }
    done

    local first_base ts output tmpdir="" merged=""
    first_base=$(basename "${FILES[0]}" .pdf)

    if [ -n "$OUTPUT_NAME" ]; then
        output="$OUTPUT_NAME"
        [ -e "$output" ] && { echo "Refusing to overwrite: $output" >&2; exit 1; }
    else
        ts=$(date +%Y%m%d_%H%M%S)
        output="${first_base}_${ts}.pdf"
    fi
    for f in "${FILES[@]}"; do
        [ "$f" = "$output" ] && { echo "Output == input: $output" >&2; exit 1; }
    done

    if [ ${#FILES[@]} -eq 1 ]; then
        merged="${FILES[0]}"
    else
        tmpdir=$(mktemp -d -t minpdf-XXXXXX)
        trap 'rm -rf "$tmpdir"' EXIT
        merged="$tmpdir/merged.pdf"
        echo "Merging ${#FILES[@]} files..."
        pdfunite "${FILES[@]}" "$merged" || { echo "pdfunite failed" >&2; exit 1; }
    fi

    echo
    echo "Input  : $merged"
    echo "Output : $output"
    echo "Quality: $QUALITY  Grayscale: $GRAYSCALE"
    echo
    minify_one "$merged" "$output" || { echo "gs failed" >&2; exit 1; }

    local in_sz=0 s
    for f in "${FILES[@]}"; do
        s=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f") || continue
        in_sz=$((in_sz + s))
    done
    local out_sz
    out_sz=$(stat -c%s "$output" 2>/dev/null || stat -f%z "$output")
    echo
    echo "Input  : $in_sz bytes"
    echo "Output : $out_sz bytes -> $output"
    [ "$in_sz" -gt 0 ] && awk -v a="$in_sz" -v b="$out_sz" \
        'BEGIN { printf "Reduction: %.1f%%\n", (a-b)*100/a }'
}

main "$@"
