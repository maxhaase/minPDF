#!/usr/bin/env bash
set -euo pipefail

MINPDF_BIN="$(command -v minpdf 2>/dev/null || echo "/usr/bin/minpdf")"

FILES=()
if [ $# -gt 0 ]; then
    FILES=("$@")
elif [ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]; then
    while IFS= read -r line; do [ -n "$line" ] && FILES+=("$line"); done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
fi

if [ ${#FILES[@]} -eq 0 ]; then
    zenity --error --text="No PDF files selected." 2>/dev/null || true
    exit 1
fi

DIR=$(dirname "${FILES[0]}")
BASE=$(basename "${FILES[0]}" .pdf)
TS=$(date +%Y%m%d_%H%M%S)
if [ ${#FILES[@]} -gt 1 ]; then DEFAULT_OUT="${BASE}_merged_${TS}.pdf"; else DEFAULT_OUT="${BASE}_${TS}.pdf"; fi

QUALITY=$(zenity --scale --title="minPDF (1/3) - Quality" \
    --text="Select compression quality for ${#FILES[@]} file(s):" \
    --min-value=10 --max-value=90 --value=70 --step=10 2>/dev/null) || exit 0

OUT_NAME=$(zenity --entry --title="minPDF (2/3) - Output Filename" \
    --text="Enter output filename:" \
    --entry-text="$DEFAULT_OUT" 2>/dev/null) || exit 0

# CRITICAL FIX: If the user leaves it blank, force the default timestamped name
if [ -z "$OUT_NAME" ]; then
    OUT_NAME="$DEFAULT_OUT"
fi

[[ "$OUT_NAME" != *.pdf ]] && OUT_NAME="${OUT_NAME}.pdf"
[[ "$OUT_NAME" != /* ]] && OUTPUT_PATH="$DIR/$OUT_NAME" || OUTPUT_PATH="$OUT_NAME"

MERGE_VAL="FALSE"
if [ ${#FILES[@]} -gt 1 ]; then
    if zenity --question --title="minPDF (3/3) - Merge" \
         --text="Merge all ${#FILES[@]} files into one PDF?" \
         --ok-label="Merge" --cancel-label="Keep Separate" 2>/dev/null; then
        MERGE_VAL="TRUE"
    fi
fi

CREATED=()

if [ ${#FILES[@]} -gt 1 ] && [ "$MERGE_VAL" == "TRUE" ]; then
    minpdf -q "$QUALITY" -o "$OUTPUT_PATH" "${FILES[@]}" 2>&1 | \
        zenity --progress --pulsate --title="minPDF" --text="Merging and compressing..." --no-cancel --auto-close 2>/dev/null
    
    if [ "${PIPESTATUS[0]}" -eq 0 ]; then
        CREATED=("$OUTPUT_PATH")
    else
        zenity --error --text="Compression failed. Check Ghostscript." 2>/dev/null; exit 1
    fi
else
    for i in "${!FILES[@]}"; do
        f="${FILES[$i]}"
        f_dir=$(dirname "$f"); f_base=$(basename "$f" .pdf)
        
        if [ "$f" = "${FILES[0]}" ]; then f_out="$OUTPUT_PATH"; else f_out="$f_dir/${f_base}_${TS}.pdf"; fi
        
        minpdf -q "$QUALITY" -o "$f_out" "$f" 2>&1 | \
            zenity --progress --pulsate --title="minPDF" --text="Compressing $(basename "$f") ($((i+1))/${#FILES[@]})..." --no-cancel --auto-close 2>/dev/null
            
        if [ "${PIPESTATUS[0]}" -eq 0 ]; then
            CREATED+=("$f_out")
        else
            zenity --error --text="Failed to compress $f" 2>/dev/null
        fi
    done
fi

if [ ${#CREATED[@]} -gt 0 ] && [ -f "${CREATED[0]}" ]; then
    MSG="Success!\n\nCreated:\n"
    for c in "${CREATED[@]}"; do MSG+="- $(basename "$c")\n"; done
    if zenity --info --title="minPDF" --text="$MSG" --ok-label="Open File" --cancel-label="Exit" 2>/dev/null; then
        xdg-open "${CREATED[0]}" >/dev/null 2>&1 &
    fi
fi
