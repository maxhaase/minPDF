#!/bin/bash
set -e
if command -v update-desktop-database >/dev/null; then
    update-desktop-database -q || true
fi
# Restart Nautilus asynchronously as the desktop user.
# Using 'sleep 1' prevents a race condition while apt finishes.
if [ -n "$SUDO_USER" ]; then
    sudo -u "$SUDO_USER" bash -c "sleep 1 && nautilus -q" &
else
    bash -c "sleep 1 && nautilus -q" &
fi
exit 0
