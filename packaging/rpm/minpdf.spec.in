Name:           minpdf
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Multi-use utility for PDF files
License:        MIT
URL:            https://github.com/maxhaase/minPDF
Source0:        minpdf-%{version}.tar.gz
BuildArch:      noarch
Requires:       ghostscript, poppler-utils, zenity
%description
Compress and merge PDF files while preserving color and quality.
%prep
%setup -q
%install
mkdir -p %{buildroot}%{_bindir}
install -m 755 minpdf     %{buildroot}%{_bindir}/minpdf
install -m 755 minpdf-gui %{buildroot}%{_bindir}/minpdf-gui
%files
%{_bindir}/minpdf
%{_bindir}/minpdf-gui
%changelog
